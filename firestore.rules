rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid == "BcB2OWFaJqTS2sxMAolO8OEAK1r1" ||
        ("email" in request.auth.token && exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // ===============================================================
    // Validation Blueprints
    // ===============================================================

    function isValidMedia(data) {
      return data.keys().hasAll(['queryKey', 'type', 'url', 'title']) &&
             data.keys().size() <= 10 &&
             data.queryKey is string && data.queryKey.size() > 0 &&
             data.type in ['image', 'video'] &&
             data.url is string && data.url.size() > 0 &&
             data.title is string && data.title.size() > 0 &&
             (!('description' in data) || data.description is string) &&
             (!('embedding' in data) || data.embedding is list) &&
             (!('keywords' in data) || data.keywords is list) &&
             (!('createdAt' in data) || data.createdAt is timestamp);
    }

    function isValidInfo(data) {
      return data.keys().hasAll(['category', 'content']) &&
             data.keys().size() <= 10 &&
             data.category is string && data.category.size() > 0 &&
             data.content is string && data.content.size() > 0 &&
             (!('embedding' in data) || data.embedding is list) &&
             (!('keywords' in data) || data.keywords is list) &&
             (!('lastUpdated' in data) || data.lastUpdated is timestamp) &&
             (!('processedAt' in data) || data.processedAt is string) &&
             (!('sourceFile' in data) || data.sourceFile is string);
    }

    function isValidCache(data) {
      return data.keys().hasAll(['question', 'answer']) &&
             data.keys().size() <= 6 &&
             data.question is string && data.question.size() > 0 && data.question.size() <= 1000 &&
             data.answer is string && data.answer.size() > 0 && data.answer.size() <= 10000 &&
             (!('timestamp' in data) || data.timestamp is timestamp) &&
             (!('lastAsked' in data) || data.lastAsked is timestamp) &&
             (!('count' in data) || data.count is number);
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    match /_connection_test_/{docId} {
      allow read: if true;
    }

    match /admins/{email} {
      allow get, list: if isSignedIn();
      allow write: if isSignedIn() && (
        request.auth.uid == "BcB2OWFaJqTS2sxMAolO8OEAK1r1" ||
        ("email" in request.auth.token && request.auth.token.email.lower() == "ibrahimalkhooly@gmail.com")
      );
    }

    match /media/{mediaId} {
      allow get, list: if true;
      allow create: if isAdmin() && isValidMedia(incoming());
      allow update: if isAdmin() && isValidMedia(incoming());
      allow delete: if isAdmin();
    }

    match /college_info/{infoId} {
      allow get, list: if true;
      allow create: if isAdmin() && isValidInfo(incoming());
      allow update: if isAdmin() && isValidInfo(incoming());
      allow delete: if isAdmin();
    }

    match /questions_cache/{cacheId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidCache(incoming());
      allow update: if isSignedIn() && isValidCache(incoming()) && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['count', 'lastAsked']);
      allow delete: if isAdmin();
    }

    // ===============================================================
    // Global Safety Net
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
